# Runtime mode: development uses SQLite; production uses PostgreSQL below.
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver,gradute-services1.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://gradute-services1.onrender.com

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=prefer

# OpenAI platform assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ASSISTANT_ENABLED=True
OPENAI_REASONING_EFFORT=none
OPENAI_TEXT_VERBOSITY=low
